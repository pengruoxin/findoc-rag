        {
          "fact_id": "growth",
          "description": "可比口径新业务价值增长率",
          "acceptable_values": [
            "28.78%",
            "28.8%"
          ],
          "unit": "%"
        }
      ],
      "evidence_sources": [
        {
          "document_key": "cninfo:601318:annual:2024",
