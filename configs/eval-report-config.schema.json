{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAG Evaluation Report Config P0",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "created_at",
    "dataset",
    "index",
    "retrieval",
    "models"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "dataset": {
      "type": "object",
      "required": [
        "dataset_id",
        "dataset_sha256",
        "split",
        "query_regime"
      ],
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "dataset_sha256": {
          "type": "string",
          "minLength": 1
        },
        "split": {
          "type": [
            "string",
            "null"
          ]
        },
        "query_regime": {
          "enum": [
            "canonical",
            "ticker_or_finance_shorthand",
            "semantic_or_relative_time",
            "all"
          ]
        }
      },
      "additionalProperties": true
    },
    "index": {
      "type": "object",
      "required": [
        "index_id",
        "corpus_index_id",
        "index_build_id"
      ],
      "properties": {
        "index_id": {
          "type": "string",
          "minLength": 1
        },
        "corpus_index_id": {
          "type": "string",
          "minLength": 1
        },
        "index_build_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "retrieval": {
      "type": "object",
      "required": [
        "mode",
        "top_k",
        "candidate_k",
        "rrf_weights",
        "metadata_filters",
        "scope",
        "adaptive",
        "reranker"
      ],
      "properties": {
        "mode": {
          "enum": [
            "lexical",
            "dense",
            "hybrid",
            "hybrid_rerank",
            "other"
          ]
        },
        "top_k": {
          "type": "integer",
          "minimum": 1
        },
        "candidate_k": {
          "type": "integer",
          "minimum": 1
        },
        "rrf_weights": {
          "type": "object",
          "required": [
            "lexical",
            "dense"
          ],
          "properties": {
            "lexical": {
              "type": "number"
            },
            "dense": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "metadata_filters": {
          "type": "object",
          "required": [
            "enabled",
            "source",
            "fields",
            "oracle"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "source": {
              "enum": [
                "none",
                "query_parser",
                "user_explicit",
                "gold_metadata",
                "oracle",
                "other"
              ]
            },
            "fields": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "oracle": {
              "type": "boolean"
            }
          },
          "additionalProperties": true
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "adaptive": {
          "type": "boolean"
        },
        "reranker": {
          "type": "object",
          "required": [
            "enabled",
            "model",
            "top_n"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "model": {
              "type": [
                "string",
                "null"
              ]
            },
            "top_n": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "models": {
      "type": "object",
      "required": [
        "dense_embedding_model",
        "generation_model",
        "judge_model"
      ],
      "additionalProperties": true
    },
    "time": {
      "type": "object",
      "properties": {
        "as_of_date": {
          "type": ["string", "null"]
        },
        "source": {
          "enum": ["none", "variant_metadata", "runner_config", "other"]
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
