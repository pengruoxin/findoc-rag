* text=auto eol=lf

# Evaluation assets are hashed byte-for-byte by data/evaluation/benchmark-lock-v1.json.
# Any platform-dependent line-ending rewrite turns the lock into a false positive,
# so pin every hashed or machine-read payload to LF regardless of core.autocrlf.
*.json    text eol=lf
*.jsonl   text eol=lf
*.py      text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf
*.sh      text eol=lf

# Windows-only helpers stay CRLF so PowerShell tooling keeps working.
*.ps1     text eol=crlf

*.pdf     binary
*.png     binary
*.npy     binary
*.npz     binary
*.sqlite3 binary
